{
  "name": "@kai/desktop",
  "version": "1.1.6",
  "private": true,
  "type": "module",
  "description": "KAI standalone desktop workbench",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run test --prefix ../..",
    "smoke": "node scripts/smoke.mjs",
    "smoke:workbench": "node scripts/smoke-workbench.mjs",
    "smoke:team": "node scripts/smoke-team.mjs",
    "smoke:mobile": "node scripts/smoke-mobile.mjs",
    "stage:engines": "node scripts/stage-engines.mjs",
    "package": "npm run stage:engines && npm run build && electron-builder --win --dir",
    "dist": "npm run stage:engines && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@kai/contracts": "0.1.0",
    "@kai/integrations": "0.1.0",
    "@kai/runtime": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron-updater": "^6.8.9",
    "flowbite": "^4.0.2",
    "flowbite-react": "^0.12.17",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "trystero": "^0.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "36.9.5",
    "electron-builder": "^26.16.1",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "ai.kai.desktop",
    "productName": "KAI",
    "asar": true,
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "King-odysseus",
        "repo": "KAi"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/integrations/launchers/start-proxy.cjs",
        "to": "integrations/start-proxy.cjs"
      },
      {
        "from": "resources/engines",
        "to": "engines"
      },
      {
        "from": "resources/agent-rules",
        "to": "agent-rules"
      },
      {
        "from": "resources/kai-cli",
        "to": "kai-cli"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
