{
  "name": "kai-agent-workbench",
  "displayName": "KAI Agent Workbench",
  "description": "A multi-agent coding workbench with route control and durable Cognitive1 memory.",
  "version": "0.3.0",
  "private": true,
  "publisher": "kai",
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "resources/kai-icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kai.openWorkbench",
        "title": "KAI: Open Agent Workbench"
      },
      {
        "command": "kai.openSettings",
        "title": "KAI: Open Settings"
      },
      {
        "command": "kai.conventions",
        "title": "KAI: How I build (conventions)"
      },
      {
        "command": "kai.openEngineRoom",
        "title": "KAI: Open Engine Room"
      },
      {
        "command": "kai.openMemory",
        "title": "KAI: Open Memory"
      },
      {
        "command": "kai.openSessions",
        "title": "KAI: Open Sessions"
      },
      {
        "command": "kai.openChatTab",
        "title": "KAI: Open Chat in Editor (full window)"
      },
      {
        "command": "kai.openGoal",
        "title": "KAI: Start or Edit Goal"
      },
      {
        "command": "kai.createAutomation",
        "title": "KAI: Create Scheduled Automation"
      },
      {
        "command": "kai.manageAutomations",
        "title": "KAI: Manage Automations and Review Queue"
      },
      {
        "command": "kai.openSkills",
        "title": "KAI: Browse Skills"
      },
      {
        "command": "kai.openRules",
        "title": "KAI: View and Edit Execution Rules"
      },
      {
        "command": "kai.setAgent",
        "title": "KAI: Set Agent"
      },
      {
        "command": "kai.setRoute",
        "title": "KAI: Set Route"
      },
      {
        "command": "kai.setAutonomy",
        "title": "KAI: Set Autonomy Mode"
      },
      {
        "command": "kai.getProxyStatus",
        "title": "KAI: Show Proxy Status"
      },
      {
        "command": "kai.restartProxy",
        "title": "KAI: Restart Proxy"
      },
      {
        "command": "kai.toggleRoute",
        "title": "KAI: Toggle Route (Direct/Proxy)"
      },
      {
        "command": "kai.cycleAutonomy",
        "title": "KAI: Cycle Autonomy Mode"
      },
      {
        "command": "kai.handoff",
        "title": "KAI: Handoff to another agent"
      },
      {
        "command": "kai.listBackups",
        "title": "KAI: List Config Backups"
      },
      {
        "command": "kai.restoreBackup",
        "title": "KAI: Restore Config Backup"
      },
      {
        "command": "kai.openBrowser",
        "title": "KAI: Open in Browser"
      },
      {
        "command": "kai.inspectRawEvents",
        "title": "KAI: Inspect Raw Events"
      },
      {
        "command": "kai.addSelectionToChat",
        "title": "KAI: Add Selection to Chat"
      },
      {
        "command": "kai.rejectCheckpointFile",
        "title": "KAI: Reject This File"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kai.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "9_kai"
        }
      ],
      "editor/title": [
        {
          "command": "kai.rejectCheckpointFile",
          "when": "resourceScheme == kai-checkpoint",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kai.addSelectionToChat",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorHasSelection"
      },
      {
        "command": "kai.setAgent",
        "key": "ctrl+shift+k a",
        "mac": "cmd+shift+k a"
      },
      {
        "command": "kai.toggleRoute",
        "key": "ctrl+shift+k r",
        "mac": "cmd+shift+k r"
      },
      {
        "command": "kai.cycleAutonomy",
        "key": "ctrl+shift+k m",
        "mac": "cmd+shift+k m"
      },
      {
        "command": "kai.openGoal",
        "key": "ctrl+shift+k g",
        "mac": "cmd+shift+k g"
      },
      {
        "command": "kai.openSkills",
        "key": "ctrl+shift+k s",
        "mac": "cmd+shift+k s"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kai",
          "title": "KAI",
          "icon": "resources/kai.svg"
        }
      ]
    },
    "views": {
      "kai": [
        {
          "id": "kai.workbench",
          "name": "Agent Workbench",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "KAI Agent Workbench",
      "properties": {
        "kai.defaultAgent": {
          "type": "string",
          "default": "claude",
          "enum": [
            "claude",
            "codex",
            "qwen",
            "gemini"
          ],
          "description": "Default agent harness for new KAI tasks."
        },
        "kai.defaultRoute": {
          "type": "string",
          "default": "direct",
          "enum": [
            "direct",
            "proxy"
          ],
          "description": "Default route for new KAI tasks."
        },
        "kai.defaultAutonomy": {
          "type": "string",
          "default": "ask",
          "enum": [
            "plan",
            "ask",
            "autoEdit",
            "full",
            "custom"
          ],
          "enumDescriptions": [
            "Read-only. Proposes a plan before touching any file.",
            "Asks before each file edit and command.",
            "Edits files without asking. Still asks before risky commands.",
            "Never asks. Best inside a worktree or a sandbox.",
            "Choose which actions need approval."
          ],
          "description": "Default autonomy mode for new KAI tasks. Legacy 'review'/'auto' values are migrated to 'ask'/'autoEdit' automatically."
        },
        "kai.conventionsRoot": {
          "type": "string",
          "default": "",
          "description": "The folder that holds all your projects. KAI reads each folder inside it to find how you usually build things and what you want things to look like, and tells every agent. Set by KAI: How I build (conventions)."
        },
        "kai.brainPath": {
          "type": "string",
          "default": "",
          "description": "External Cognitive1 brain data folder. KAI ships code, not private memory."
        },
        "kai.executionRulesPath": {
          "type": "string",
          "default": "",
          "description": "Path to the authoritative Cognitive1 Instruct.md rule file. Empty auto-detects a sibling cognitive1 project or ~/.kai/brain/Instruct.md."
        },
        "kai.cognitive1Enabled": {
          "type": "boolean",
          "default": true,
          "description": "Call the local Cognitive1 HTTP daemon for session and recall events."
        },
        "kai.cognitive1Url": {
          "type": "string",
          "default": "http://127.0.0.1:9876",
          "description": "Base URL for the Cognitive1 HTTP daemon."
        },
        "kai.codexCommand": {
          "type": "string",
          "default": "codex",
          "description": "Command used to launch Codex CLI."
        },
        "kai.codexProxyProfile": {
          "type": "string",
          "default": "codeproxy",
          "description": "Codex profile name used when KAI route is Proxy."
        },
        "kai.codexConfigModel": {
          "type": "string",
          "default": "gpt-5.5",
          "description": "Placeholder model written to the KAI-managed Codex proxy profile."
        },
        "kai.proxyPort": {
          "type": "number",
          "default": 8082,
          "description": "Local ClaudeCode-Proxy port used by KAI-managed agent profiles."
        },
        "kai.proxyScript": {
          "type": "string",
          "default": "",
          "description": "Path to the proxy server script. Leave empty to skip proxy auto-start."
        },
        "kai.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to launch Claude Code when the process adapter is enabled."
        },
        "kai.qwenCommand": {
          "type": "string",
          "default": "qwen",
          "description": "Command used to launch Qwen Code CLI via ACP."
        },
        "kai.geminiCommand": {
          "type": "string",
          "default": "gemini",
          "description": "Command used to launch Gemini CLI via ACP."
        },
        "kai.cognitive1Embedded": {
          "type": "boolean",
          "default": true,
          "description": "Use embedded file-based Cognitive1 (no external server needed). Disable to use an external Cognitive1 HTTP daemon."
        },
        "kai.proxy.targetBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "Base URL of the upstream API for the KAI built-in proxy."
        },
        "kai.proxy.apiKey": {
          "type": "string",
          "default": "",
          "description": "DEPRECATED: Upstream API keys are now stored in OS keychain (SecretStorage). Use the Settings panel to save keys securely. This field is ignored when a key exists in SecretStorage."
        },
        "kai.proxy.defaultModel": {
          "type": "string",
          "default": "deepseek-v4-pro",
          "description": "Default upstream model for the KAI proxy when no mapping is found."
        },
        "kai.proxy.modelMap": {
          "type": "object",
          "default": {
            "claude-opus-4-7": "deepseek-v4-pro",
            "claude-sonnet-4-6": "deepseek-flash",
            "claude-haiku-4-5-20251001": "deepseek-flash"
          },
          "description": "Map model names to upstream model names for the KAI proxy."
        },
        "kai.proxy.routeClaudeCode": {
          "type": "boolean",
          "default": false,
          "description": "Route Claude Code through the KAI proxy."
        },
        "kai.proxy.routeCodex": {
          "type": "boolean",
          "default": false,
          "description": "Route Codex through the KAI proxy."
        },
        "kai.proxy.codexConfig": {
          "type": "object",
          "default": {
            "enabled": false,
            "baseUrl": "https://api.openai.com/v1",
            "defaultModel": "gpt-5.5",
            "configModel": "gpt-5.5"
          },
          "description": "Per-agent backend for Codex via the KAI proxy. API keys are stored in OS keychain (use the Settings panel)."
        },
        "kai.proxy.qwenConfig": {
          "type": "object",
          "default": {
            "enabled": false,
            "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
            "defaultModel": "qwen-coder-plus"
          },
          "description": "Per-agent backend for Qwen via the KAI proxy. API keys are stored in OS keychain (use the Settings panel)."
        },
        "claudeProxy.targetBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DEPRECATED: Use kai.proxy.targetBaseUrl instead. Base URL of the upstream API for proxy mode."
        },
        "claudeProxy.apiKey": {
          "type": "string",
          "default": "",
          "description": "DEPRECATED: API keys are now stored in OS keychain via the Settings panel. This field is migrated automatically on next activation."
        },
        "claudeProxy.apiKeys": {
          "type": "object",
          "default": {},
          "description": "DEPRECATED: API keys are now stored in OS keychain via the Settings panel. These are migrated automatically on next activation."
        },
        "claudeProxy.defaultModel": {
          "type": "string",
          "default": "deepseek-v4-pro",
          "description": "DEPRECATED: Use kai.proxy.defaultModel instead. Default upstream model when no mapping is found."
        },
        "claudeProxy.modelMap": {
          "type": "object",
          "default": {
            "claude-opus-4-7": "deepseek-v4-pro",
            "claude-sonnet-4-6": "deepseek-flash",
            "claude-haiku-4-5-20251001": "deepseek-flash"
          },
          "description": "DEPRECATED: Use kai.proxy.modelMap instead."
        },
        "claudeProxy.routeClaudeCode": {
          "type": "boolean",
          "default": false,
          "description": "DEPRECATED: Use kai.proxy.routeClaudeCode instead."
        },
        "claudeProxy.routeCodex": {
          "type": "boolean",
          "default": false,
          "description": "DEPRECATED: Use kai.proxy.routeCodex instead."
        },
        "claudeProxy.codexConfig": {
          "type": "object",
          "default": {
            "enabled": false,
            "baseUrl": "https://api.openai.com/v1",
            "apiKey": "",
            "defaultModel": "gpt-5.5",
            "configModel": "gpt-5.5"
          },
          "description": "DEPRECATED: Use kai.proxy.codexConfig instead. API keys are now stored in OS keychain."
        },
        "claudeProxy.qwenConfig": {
          "type": "object",
          "default": {
            "enabled": false,
            "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
            "apiKey": "",
            "defaultModel": "qwen-coder-plus"
          },
          "description": "DEPRECATED: Use kai.proxy.qwenConfig instead. API keys are now stored in OS keychain."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "typecheck:portable": "tsc -p tsconfig.portable.json --noEmit",
    "desktop:dev": "npm run dev --workspace @kai/desktop",
    "desktop:build": "npm run build --workspace @kai/desktop",
    "desktop:typecheck": "npm run typecheck --workspace @kai/desktop",
    "desktop:test": "npm run test --workspace @kai/desktop",
    "desktop:smoke": "npm run smoke --workspace @kai/desktop",
    "desktop:smoke:workbench": "npm run smoke:workbench --workspace @kai/desktop",
    "desktop:smoke:team": "npm run smoke:team --workspace @kai/desktop",
    "desktop:smoke:mobile": "npm run smoke:mobile --workspace @kai/desktop",
    "desktop:package": "npm run package --workspace @kai/desktop",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:closeout": "npm run test:fast && npm run test:slow && npm run test:integration",
    "lint": "eslint src/ test/ --ext .ts",
    "lint:fix": "eslint src/ test/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "package": "npm run compile && vsce package --allow-missing-repository"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
